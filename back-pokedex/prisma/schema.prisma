
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model pokemon {
  id                Int     @id
  nombre            String  @db.VarChar(255)
  descripcion       String  @db.VarChar(255)
  grunido           String  @db.VarChar(255)
  imagen            String  @db.VarChar(255)
  vida              Int
  ataque            Int
  defensa           Int
  ataqueEspecial    Int     @map("ataque-especial")
  defensaEspecial   Int     @map("defensa-especial")
  velocidad         Int
  tipoPokemon       tipo_pokemon[]

  //@@map("")

}

model tipo_pokemon {
id        Int     @id @default(autoincrement())
nombre    String  @unique @db.VarChar(255)
pokemones pokemon []

}

model usuario {
id          Int     @id @default(autoincrement())
username    String  @unique @db.VarChar(255)
contrasena  String  @unique @db.VarChar(255)

}